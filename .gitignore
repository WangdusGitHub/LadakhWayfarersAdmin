# =========================================================================
# Ladakh Wayfarers Admin — Git Ignore Configuration
# =========================================================================

# 1. Environment variables and private secrets
.env
.env.*
*.env

# 2. Dependencies
node_modules/
jspm_packages/

# 3. Local Runtime Database Cache (Contains local backup data & session caches)
local-data-cache.json
*.local

# 4. User Uploaded Files (Local fallback storage - keep folder via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# 5. Logs & Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 6. Operating System & System-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 7. IDE & Code Editor files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# 8. Temporary and build artifacts
.cache
tmp/
temp/
*.tmp
